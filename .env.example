# Copy this file to ".env" and fill in your values. NEVER commit the real .env.

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" while testing with fake data, "production" for the real card.
PLAID_ENV=sandbox
# Filled in automatically after you run: python link_card.py
PLAID_ACCESS_TOKEN=

# --- Delivery channel: "email" (today) or "twilio" (once A2P is approved) ---
NOTIFY_CHANNEL=email

# --- Channel: email-to-SMS gateway ---
# EMAIL_FROM is your Gmail address. EMAIL_APP_PASSWORD is a 16-char Gmail
# "App Password" (Google account -> Security -> App passwords), NOT your login.
EMAIL_FROM=you@gmail.com
EMAIL_APP_PASSWORD=
# Carrier gateway addresses, comma-separated (10 digits, no +1):
#   T-Mobile 5551234567@tmomail.net | AT&T 5551234567@txt.att.net | Verizon 5551234567@vtext.com
SMS_GATEWAYS=5551234567@tmomail.net

# --- Channel: Twilio (only needed when NOTIFY_CHANNEL=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14253997205
# Phone numbers in E.164, comma-separated:
SMS_RECIPIENTS=+12065551234

# --- Budget & schedule ---
MONTHLY_BUDGET=9000
TIMEZONE=America/Los_Angeles
DELIVERY_HOUR=8
